# Web3Forms access key used by src/lib/enquire.js to submit the enquiry
# form to https://api.web3forms.com/submit. Generate the key in the
# Web3Forms dashboard and confirm the recipient email there.
# This key is a public, browser-exposed integration key (VITE_ prefix),
# not a private backend secret. Never commit the real .env file.
VITE_WEB3FORMS_ACCESS_KEY=YOUR_ACTUAL_ACCESS_KEY
