# Adsrow React/Vite SPA rules for Apache/Hostinger.
# Upload the contents of dist/ (including this file) into public_html.
RewriteEngine On

# Canonical HTTPS for the production host only. Temporary hosts and local
# previews are deliberately left untouched.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?adsrow\.com$ [NC]
RewriteRule ^ https://adsrow.com%{REQUEST_URI} [R=301,L,NE]

# Use the branded static document as Apache's actual 404 response.
ErrorDocument 404 /404.html

# Serve existing files and directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# A request that looks like a missing asset must remain a 404, not become HTML.
RewriteCond %{REQUEST_URI} \.[^/]+$ [NC]
RewriteRule ^ - [R=404,L]

# These are valid client-side routes that are intentionally not prerendered
# (auth, protected, admin and legacy redirect flows). app.html is the neutral
# SPA shell with an empty React root (generated by scripts/prerender.mjs), so
# these URLs never inherit a prerendered route's markup or canonical metadata.
RewriteRule ^(login|signup|forgot-password|reset-password|dashboard|admin|partner-form|advertise|advertise/enquiry|locations|package-comparison)(/)?$ app.html [L]

# Blog article slugs are intentionally NOT whitelisted here. Articles are
# pending publication and are neither linked nor prerendered yet, so any slug
# without a prerendered page must return a real 404 instead of the SPA shell
# (otherwise unknown slugs serve the homepage document with its canonical).
# Once an article is published, its prerendered dist/blog/<slug>/ directory is
# served automatically by the existing-files rule above.

# Unknown extensionless paths must be a real HTTP 404, not an indexable 200.
RewriteRule ^ - [R=404,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/wasm
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>

# Add a reviewed Content-Security-Policy after confirming all external font,
# map, Supabase, OAuth and form-provider origins used by the deployment.
